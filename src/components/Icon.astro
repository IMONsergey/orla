---
type IconName = 'arrow-left' | 'arrow-right' | 'arrow-up' | 'arrow-up-right' | 'close' | 'plus' | 'minus';
interface Props { name: IconName; class?: string }
const { name, class: className } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-left': 'M20 12H4m7-7-7 7 7 7',
  'arrow-right': 'M4 12h16m-7-7 7 7-7 7',
  'arrow-up': 'M12 20V4m-7 7 7-7 7 7',
  'arrow-up-right': 'M5 19 19 5M5 5h14v14',
  close: 'm6 6 12 12M6 18 18 6',
  plus: 'M12 5v14M5 12h14',
  minus: 'M5 12h14',
};
---
<svg class:list={['ui-icon', className]} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
