---
import { asset } from '../data/assets';
---
<dialog id="enquiry-dialog" class="sheet enquiry" aria-labelledby="enquiry-title">
  <button type="button" class="round-close" data-close aria-label="Close enquiry">×</button>
  <div class="enquiry__layout">
    <aside class="enquiry__context">
      <p class="eyebrow">ORLA, Dorchester Collection</p>
      <h3 data-interest>Explore ORLA</h3>
      <p>Palm Jumeirah, Dubai</p>
      <img class="enquiry__photo" src={asset('1:87','imgImg2')} alt="Curving ORLA terraces and palms" width="990" height="645" loading="lazy" />
      <p>Tell us how to reach you. We will help you explore your residence.</p>
      <button type="button" class="back-link" data-close><span aria-hidden="true">←</span> Back to ORLA</button>
    </aside>
    <section class="enquiry__main">
      <h2 id="enquiry-title">A touch<br />of perfection</h2>
      <p class="enquiry__subtitle">Submit your expression of interest</p>
      <form id="enquiry-form" novalidate>
        <input type="hidden" name="context" value="Explore ORLA" />
        <p class="enquiry__selection" data-interest-summary>Explore ORLA</p>
        <div class="honeypot" aria-hidden="true"><label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
        <label class="field"><span>Your name</span><input name="name" autocomplete="name" required maxlength="100" placeholder="Your name" aria-describedby="error-name" /><small id="error-name" data-error="name"></small></label>
        <label class="field"><span>Email address</span><input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="Enter your e-mail" aria-describedby="error-email" /><small id="error-email" data-error="email"></small></label>
        <label class="field"><span>Phone number</span><input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="Phone number" aria-describedby="error-phone" /><small id="error-phone" data-error="phone"></small></label>
        <fieldset class="contact-method"><legend>Preferred method of contact</legend><label><input type="radio" name="method" value="Phone" /> Phone</label><label><input type="radio" name="method" value="Email" checked /> E-mail</label></fieldset>
        <label class="field field--message"><span>Message <em>(optional)</em></span><textarea name="message" maxlength="1960" rows="2" placeholder="Tell us what you are looking for"></textarea></label>
        <label class="consent"><input type="checkbox" name="consent" required aria-describedby="error-consent" /><span>I agree to be contacted about my enquiry and to the <button class="text-link" type="button" data-privacy>Privacy Policy</button>.</span></label>
        <small class="field-error" id="error-consent" data-error="consent"></small>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <button type="submit" class="submit"><span data-submit-label>Send interest</span><span class="submit__circle" aria-hidden="true">→</span></button>
      </form>
      <div class="enquiry__success" hidden tabindex="-1">
        <p class="eyebrow" data-success-interest></p>
        <h3>Thank you.<br />Your enquiry<br />is saved.</h3>
        <p>Your expression of interest has been saved privately for the website owner to review and respond.</p>
        <button type="button" class="submit" data-close><span>Return to residences</span><span class="submit__circle" aria-hidden="true">→</span></button>
      </div>
    </section>
  </div>
</dialog>
