---
import { asset } from '../data/assets';
interface Props { label: string; caption?: string; href?: string; context?: string; modal?: string; category?: string; class?: string; }
const { label, caption, href, context, modal, category, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : 'button'} class:list={['action', className]} data-enquire={context} data-modal={modal} data-category={category}>
  <span class="action__icon" aria-hidden="true"><img src={asset('1:63', 'imgBtnX')} width="51" height="51" alt="" /></span>
  <span class="action__text"><span>{label}</span>{caption && <small>{caption}</small>}</span>
</Tag>
<style>
  .action{display:inline-flex;align-items:center;gap:20px;padding:0;border:0;background:none;color:inherit;text-align:left;text-decoration:none;font:inherit;cursor:pointer;max-width:100%}
  .action__icon{flex:none;display:grid;place-items:center;transition:transform .35s cubic-bezier(.2,.7,.3,1)}
  .action__icon img{display:block;width:51px;height:51px}
  .action__text{display:flex;flex-direction:column;gap:3px;font-size:16px;line-height:1.5}
  small{font-size:13px;color:var(--gold);line-height:1.5}
  .action:hover .action__icon{transform:rotate(90deg)}
  .action:focus-visible{outline:2px solid var(--gold);outline-offset:8px;border-radius:4px}
  @media(prefers-reduced-motion:reduce){.action__icon{transition:none}}
  @media(max-width:600px){.action{gap:16px}.action__text{font-size:15px}small{font-size:11px}}
</style>
